# For local development only; do not commit .env to GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4173
# When deploying on Render, RENDER_EXTERNAL_URL is used automatically.
# PAUSEPILOT_SESSION_SECRET should be a random string >=32 chars in production.
# PAUSEPILOT_SESSION_SECRET=
PAUSEPILOT_PER_IP_MINUTE=8
PAUSEPILOT_PER_SESSION_HOUR=30
PAUSEPILOT_GLOBAL_DAILY_CAP=150
PAUSEPILOT_MAX_IN_FLIGHT=3
