{
  "manifest_version": 3,
  "name": "PausePilot — Send Guard, Relaxation & Sample Insights (Beta)",
  "description": "Opt-in Gmail Send Guard, local-only movement lab, calming audio, breathing guidance, and a synthetic-data insights dashboard.",
  "version": "0.4.6",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:4173/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "PausePilot",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4173/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail-helpers.js",
        "content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost:4173/*",
        "https://mail.google.com/*",
        "https://pausepilot-buildathon-demo.onrender.com/*"
      ],
      "js": [
        "movement-engine.js",
        "relaxation-core.js",
        "movement-monitor.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
